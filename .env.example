# =============================================================
# DocuMind AI — Environment Variables Example
# Copy this file to .env and fill in your values
# =============================================================

# ── Application ──────────────────────────────────────────────
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-string

# ── Database (PostgreSQL) ─────────────────────────────────────
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=your-strong-db-password-here

# ── AI / LLM ──────────────────────────────────────────────────
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash
# Use LLM_PROVIDER=mock only for deterministic test data.

# ── OCR ──────────────────────────────────────────────────────
# Use tesseract for low-memory/free deployments; easyocr is available locally.
OCR_PROVIDER=tesseract
# Windows: set this to Poppler's bin directory if it is not on PATH.
# Docker installs Poppler system-wide, so leave this empty there.
POPPLER_PATH=

# ── Docker Ports ─────────────────────────────────────────────
FRONTEND_PORT=80
